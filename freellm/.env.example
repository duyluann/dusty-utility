TRAEFIK_HOST=example.com
TRAEFIK_SUBDOMAIN=freellm
COMPOSE_PROJECT_NAME=dusty-utility

# FreeLLMAPI image tag
FREELLM_TAG=v0.16.6

# Required — generate: openssl rand -hex 32 (rotating it orphans every stored provider key)
ENCRYPTION_KEY=

# Container memory cap (compose mem_limit)
FREELLM_MEM_LIMIT=1g
